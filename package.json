{
  "name": "bb-plugin-korey",
  "version": "0.1.0",
  "private": true,
  "description": "Consult Korey and send interactively approved Shortcut changes from any BB provider.",
  "license": "MIT",
  "author": "Shortcut",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/useshortcut/bb-plugin-korey.git"
  },
  "homepage": "https://github.com/useshortcut/bb-plugin-korey#readme",
  "bugs": {
    "url": "https://github.com/useshortcut/bb-plugin-korey/issues"
  },
  "engines": {
    "node": "^22.19.0 || ^24.0.0 || ^26.0.0",
    "bb": ">=0.40.0",
    "bbPluginSdk": ">=0.4.10"
  },
  "bb": {
    "name": "Korey",
    "description": "Consult Korey and send interactively approved Shortcut changes from any BB provider.",
    "branding": {
      "icon": "Sparkles"
    },
    "server": "./plugin/server.ts",
    "app": "./plugin/app.tsx",
    "host": "./plugin/host.ts",
    "skills": [
      "skills"
    ]
  },
  "keywords": [
    "bb-plugin",
    "korey",
    "shortcut",
    "product-management"
  ],
  "scripts": {
    "build": "bb plugin build .",
    "check": "npm run lint && npm run check:format && npm run check:sdk && npm run typecheck && npm test && npm run build && npm run check:openapi",
    "check:format": "oxfmt --check .",
    "check:openapi": "npm run generate:openapi && git diff --exit-code -- generated/korey-api.ts",
    "check:sdk": "bb plugin types --check",
    "format": "oxfmt --write .",
    "generate:openapi": "typed-openapi korey.openapi.json --output generated/korey-api.ts --runtime zod --validate-side output --no-runtime-types --no-include-client --format",
    "lint": "oxlint --deny-warnings .",
    "openapi:sync": "node scripts/sync-korey-openapi.mjs",
    "test": "vitest run --config plugin/vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.5.9",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bb-app": "0.43.4",
    "better-sqlite3": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "jsdom": "^29.0.1",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typed-openapi": "4.0.1",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2",
    "vitest": "^4.1.1"
  }
}
