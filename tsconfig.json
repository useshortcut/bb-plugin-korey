{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "skipLibCheck": false,
    "types": ["node"]
  },
  "include": ["plugin/**/*.ts", "plugin/**/*.tsx", "generated/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
